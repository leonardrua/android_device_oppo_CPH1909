         second entry for the same HAL name and major version is rejected by
         assemble_vintf. @1.1::IMediaCasService extends @1.0, so the framework
         matrix is satisfied by the fragment alone. -->
    <hal format="hidl">
        <name>android.hardware.configstore</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ISurfaceFlingerConfigs/default</fqname>
    </hal>
