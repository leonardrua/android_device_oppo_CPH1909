cc_library_shared {
    name: "libims_abi_v28",
    proprietary: true,
    compile_multilib: "both",
    srcs: ["ims_abi.cpp"],
    shared_libs: [
        "libc",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// libimsma_socketwrapper.so is a /system/lib blob; give it a system-side copy.
cc_library_shared {
    name: "libims_abi_v28_system",
    stem: "libims_abi_v28",
    compile_multilib: "both",
    srcs: ["ims_abi.cpp"],
    shared_libs: [
        "libc",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
