//
// The consumers of this shim are the KPOC charging blobs, which live in
// /system/lib (libshowlogo.so, libsysenv_system.so). They load in the system
// namespace, so the shim must be installed to /system/lib — a /vendor/lib copy
// would be invisible to them. That also means it may link libgui, which is a
// system-only library.

cc_library_shared {
    name: "libshim_showlogo",
    compile_multilib: "32",
    srcs: ["libshim_showlogo.cpp"],
    shared_libs: [
        "libgui",
        "libui",
        "libutils",
        "libc++",
        "libc",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
