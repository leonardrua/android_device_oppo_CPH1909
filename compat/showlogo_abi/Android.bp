cc_library_shared {
    name: "libshim_showlogo",
    proprietary: true,
    compile_multilib: "32",
    srcs: ["libshim_showlogo.cpp"],
    shared_libs: [
        "libgui",
        "libui",
        "libutils",
        "libc++",
        "libc",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
