cc_library_shared {
    name: "libaudio_abi_v28",
    proprietary: true,
    compile_multilib: "both",
    srcs: [
        "audio_abi.cpp",
        "broadcastradio.cpp",
        "HidlUtils.cpp",
    ],
    local_include_dirs: ["."],
    shared_libs: [
        "android.hardware.audio.common@2.0",
        "libhidlbase",
        "liblog",
        "libutils",
        "libc++",
        "libc",
    ],
    include_dirs: [
        "system/media/audio/include",
        "hardware/libhardware/include",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
