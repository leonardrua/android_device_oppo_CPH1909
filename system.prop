#
# System properties for OPPO A5s (CPH1909, MT6765).
#
# Only properties that the framework/AOSP side needs and that the stock
# ColorOS system build.prop set for this hardware. Everything the vendor blobs
# read lives in vendor.prop instead.
#

# Display
ro.sf.lcd_density=320

# Radio
#
# The MTK RIL blobs are loaded by name through the generic rild shim, so the
# framework needs these two to pick the right library and device node.
rild.libpath=mtk-ril.so
rild.libargs=-d /dev/ttyC0

# Wi-Fi
wifi.interface=wlan0
wifi.direct.interface=p2p0
wifi.tethering.interface=ap0

# Wi-Fi feature gates read by the MediaTek wpa_supplicant/wifi blobs. The
# stock system.prop set all three; without them the blobs fall back to their
# compiled-in defaults, which disable Wi-Fi Simple Config and Wi-Fi Display.
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0

# Hardware keys: this device has no capacitive navigation bar
qemu.hw.mainkeys=0

# Camera
# The stock ROM forced the shutter-sound policy off; without it CameraService
# falls back to the region default.
ro.camera.sound.forced=0

# Audio
ro.audio.silent=0

# Dalvik
#
# ro.config.low_ram is read by core/jni/AndroidRuntime.cpp and by
# RoSystemProperties/ActivityManager. The stock device (3/4 GB RAM) is not a
# low-RAM device.
ro.config.low_ram=false

# Zygote
#
# lineage_CPH1909.mk inherits core_64_bit.mk, which already sets
# ro.zygote=zygote64_32 through PRODUCT_VENDOR_PROPERTIES. It is deliberately
# not repeated here: the build-system value is authoritative and a second copy
# only invites drift.

# Crypto
#
# The fstab uses classic FDE (`encryptable=<metadata partition>`), not
# dm-default-key metadata encryption and not FBE. Of the ro.crypto.* switches,
# only allow_encrypt_override is used by the FDE path (vold cryptfs.cpp).
# `ro.crypto.dm_default_key.options_format.version` does not exist in the
# Android 10 vold at all (it was added in a later release), and
# `ro.crypto.volume.filenames_mode` is only consulted for adoptable-storage
# volume keys, so neither is set here.
ro.crypto.allow_encrypt_override=true

# MediaTek-specific framework bits
ro.kernel.zio=38,108,105,16
ro.zygote.preload.enable=0

# Performance
#
# MediaTek's framework performance hints: the simple and fast start-window
# optimizations and the response-time boost. The stock system build.prop set all
# three; without them the framework skips the MTK perf hints entirely.
ro.mtk_perf_simple_start_win=1
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1
