#
# System properties for OPPO A5s (CPH1909, MT6765).
# Framework/AOSP side only; vendor blob properties live in vendor.prop.
#

# Display
ro.sf.lcd_density=320

# Graphics
# Ignore vendor texture swizzle: stock GE8320 mishandles it and HWUI aborts.
ro.skia.ignore_swizzle=true

# Brand
Build.BRAND=MTK

# Radio
# MTK RIL blobs are loaded by name; the framework needs these two.
rild.libpath=mtk-ril.so
rild.libargs=-d /dev/ttyC0

# Wi-Fi
wifi.interface=wlan0
wifi.direct.interface=p2p0
wifi.tethering.interface=ap0

# Stock MediaTek wpa_supplicant/wifi feature gates.
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0

# Hardware keys: no capacitive navigation bar
qemu.hw.mainkeys=0

# Camera
# Stock forced shutter-sound policy off; otherwise CameraService uses the region default.
ro.camera.sound.forced=0

# Audio
ro.audio.silent=0

# Codecs
# Codec2 ION dmabuf faults on queueCSDInputBuffer; disable CCodec to stop the crash loop.
debug.stagefright.ccodec=0

# Dalvik
# This device (3/4 GB RAM) is not low-RAM.
ro.config.low_ram=false

# Zygote
# ro.zygote comes from core_64_bit.mk; do not duplicate it here.

# Crypto
# Classic FDE only; other ro.crypto.* switches do not apply on Android 10 vold.
ro.crypto.allow_encrypt_override=true

# MediaTek-specific framework bits
ro.kernel.zio=38,108,105,16
ro.zygote.preload.enable=0

# Performance
# Stock MTK performance hints.
ro.mtk_perf_simple_start_win=1
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1

# ADB: stock 4.9 ffs_user_copy_worker faults with fs=KERNEL_DS on every shell.
# Disable adbd's nonblocking FunctionFS path (adb/daemon/usb.cpp:740-748).
persist.adb.nonblocking_ffs=0
ro.adb.nonblocking_ffs=0
