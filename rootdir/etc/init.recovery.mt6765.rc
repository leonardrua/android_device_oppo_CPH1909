# Recovery-specific init for the OPPO A5s (CPH1909, MT6765).
#
# Recovery imports this file from its ramdisk root as
#     import /init.recovery.${ro.hardware}.rc
# and ro.hardware is mt6765 (androidboot.hardware=mt6765).

on early-init
    # The recovery fstab addresses every partition through
    # /dev/block/platform/bootdevice/by-name/*; MTK also exposes the boot
    # device as /dev/block/bootdevice, and tools expect that alias to exist
    # before the fstab is read.
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice

on init
    # Make the LCD backlight writable so a recovery boot on a flat battery is
    # visible; recovery drives /sys/class/leds/lcd-backlight.
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0644 /sys/class/leds/lcd-backlight/brightness

on fs
    # Trustonic TEE nodes (keymaster/soter). Sideload of a signed package needs
    # them accessible to recovery.
    chmod 0666 /dev/mobicore
    chmod 0666 /dev/mobicore-user

on boot
    # Recovery can sit idle at the menu for a long time; disable the MTK
    # hung-task watchdog so it does not fire while waiting for input.
    write /proc/sys/kernel/hung_task_timeout_secs 0