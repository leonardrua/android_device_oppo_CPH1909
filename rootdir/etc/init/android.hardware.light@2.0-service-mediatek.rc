# Override the stock MediaTek light HIDL service (light-hal-2-0).
#
# The custom android.hardware.light@2.0-service.CPH1909 (light/) registers
# android.hardware.light@2.0::ILight and drives /sys/class/leds/lcd-backlight
# directly. The stock service would register the same default interface and
# contend for the backlight, so disable it. PRODUCT_COPY_FILES keeps the first
# entry for a destination, so this override is installed before the
# CPH1909-vendor.mk inherit (see device.mk).
service light-hal-2-0 /vendor/bin/hw/android.hardware.light@2.0-service-mediatek
    override
    class hal
    user system
    group system
    disabled
    oneshot