# Double-tap-to-wake toggle for the OPPO touchpanel proc interface.
#
# CPH1909 (MT6765, oppo6765_18511) uses a multi-panel SPI touch node
# (ili_ts@0 on spi3, authoritative 8.1 kernel DTS) whose Himax summer /
# NT36525B / Ilitek ipio_mmi drivers expose /proc/touchpanel/double_tap_enable.
# NT36xxx (non-B) uses WAKEUP_GESTURE/KEY_POWER internally; if its proc node is
# absent, the writes below are harmless no-ops in effect (logged by init).

on boot
    chown system system /proc/touchpanel/double_tap_enable
    chmod 0660 /proc/touchpanel/double_tap_enable

on property:sys.boot_completed=1 && property:persist.vendor.dt2w=1
    write /proc/touchpanel/double_tap_enable 1

on property:sys.boot_completed=1 && property:persist.vendor.dt2w=0
    write /proc/touchpanel/double_tap_enable 0

on property:persist.vendor.dt2w=1
    write /proc/touchpanel/double_tap_enable 1

on property:persist.vendor.dt2w=0
    write /proc/touchpanel/double_tap_enable 0

# Compatibility with ROM hooks that use the non-vendor persist property.
on property:persist.sys.dt2w=1
    setprop persist.vendor.dt2w 1

on property:persist.sys.dt2w=0
    setprop persist.vendor.dt2w 0
