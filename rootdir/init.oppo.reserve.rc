##################################################################################
### Adapted from the OPPO CPH1909 8.1 boot ramdisk init.oppo.reserve.rc
###
### /opporeserve is mounted from the opporeserve2 partition by
### mount_all /vendor/etc/fstab.mt6765 in the stock vendor `on fs` block, which
### runs before post-fs-data. The stock directory tree is kept as-is.
###
### The stock trailing `restorecon_recursive /opporeserve` is dropped: this
### policy labels the whole partition as oppo_reserve_file (the stock
### fine-grained media/system/camera types are not defined here), so every
### directory below inherits that label and there is nothing to relabel.
##################################################################################

# Android 10's Wi-Fi HAL drives nl80211 directly and never opens /dev/wmtWifi,
# so MediaTek's WiFi function stays off and no wlan0 is ever created. The stock
# libwifi-hal used to write "1" here; do the same only after wmt_launcher has
# configured STP (it sets formeta.ready after "set STP mode success"). Writing
# earlier makes pwr_on fail and tears down stp_if_tx.
on property:service.wcn.formeta.ready=yes
    write /dev/wmtWifi 1

on post-fs-data
    # Android 10's wpa_supplicant requires its config files before it will
    # start. The stock /data image shipped them; a freshly flashed /data does
    # not, so seed them from /vendor/etc/wifi.
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    copy /vendor/etc/wifi/wpa_supplicant.conf /data/misc/wifi/wpa_supplicant.conf
    copy /vendor/etc/wifi/wpa_supplicant.conf /data/misc/wifi/p2p_supplicant.conf
    chown wifi wifi /data/misc/wifi/wpa_supplicant.conf
    chown wifi wifi /data/misc/wifi/p2p_supplicant.conf
    chmod 0660 /data/misc/wifi/wpa_supplicant.conf
    chmod 0660 /data/misc/wifi/p2p_supplicant.conf

    mkdir /opporeserve/radio 0770 radio system
    mkdir /opporeserve/system 0770 system system
    mkdir /opporeserve/system/config 0770 system system
    mkdir /opporeserve/media 0770 system system
    mkdir /opporeserve/media/dropbox 0770 system system
    mkdir /opporeserve/media/log 0770 system system
    mkdir /opporeserve/media/log/usage 0770 system system
    mkdir /opporeserve/media/log/criticalLog 0770 system system
    mkdir /opporeserve/media/log/criticalLog/persist 0770 system system
    mkdir /opporeserve/media/log/criticalLog/cache 0770 system system
    mkdir /opporeserve/media/engineermode 0770 system system
    mkdir /opporeserve/media/ColorOS 0770 system system
    mkdir /opporeserve/media/Camera 0770 system system
