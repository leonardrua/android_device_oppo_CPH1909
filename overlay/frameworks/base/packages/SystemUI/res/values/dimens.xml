<resources>

    <!-- The A5s uses a panel with physically rounded corners: the MT6765
         kernel enables round-corner support (CONFIG_MTK_ROUND_CORNER_SUPPORT)
         and every LCM driver shipped for this device declares a corner
         pattern. In SystemUI this dimension is applied as the start/end
         margin of the gesture-navigation layout, so it must be at least the
         panel's corner radius or the navigation content draws under the
         corner curve. 34px is the value used by the sibling OPPO A12/A11k
         (OP4BFB), which is the same Helio P35 with a 720x1520 panel, and it
         matches the 32px corner constant used by the MT6765 720p LCM
         drivers in this kernel. -->
    <dimen name="rounded_corner_content_padding">34.0px</dimen>

</resources>
