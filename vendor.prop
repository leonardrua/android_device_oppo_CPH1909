#
# Vendor properties for OPPO A5s (CPH1909, MT6765).
# Stock ColorOS 5.2 values for the prebuilt MTK / OPPO 8.1 blobs. The blobs read
# the stock unprefixed ro.mtk_* names, not the Android-10 ro.vendor.mtk_* ones.
#

# Audio
ro.mtk_audio_tuning_tool_ver=V2.2
ro.audio.usb.period_us=16000
ro.mtk_audio_alac_support=1
ro.mtk_audio_ape_support=1
ro.mtk_dual_mic_support=0
# Skip effects config loading: the stock 8.1 effects path can crash in
# libeffects.so and watchdog-reboot system_server. Read by EffectsFactory
# init(); ro.* so a stale /data/property value cannot override it.
ro.audio.ignore_effects=true

# Dirac (values the stock Dirac daemon / effect framework read at boot)
ro.dirac.config=192
ro.dirac.poolsize=2
ro.dirac.max_active.headset=5
ro.dirac.max_active.powersound=3
persist.dirac.acs.controller=afm
persist.dirac.afm.mode=global
persist.dirac.acs.startAtBoot=3

# Camera
ro.mtk_camera_app_version=3
ro.mtk_fd_support=1
camera.disable_zsl_mode=1
camera.mdp.cz.enable=1
camera.mdp.dre.enable=0
ro.mtk_cam_mfb_support=3
ro.mtk_cam_stereo_camera_support=1
ro.mtk_slow_motion_support=1
ro.mtk_zsdhdr_support=1

# Display / graphics
# ro.hardware.egl=mtk makes the EGL loader pick libEGL_mtk.so (the PowerVR
# blob set); without it the loader looks for a non-existent libEGL_mt6765.
ro.hardware.egl=mtk
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.has_HDR_display=false
debug.sf.disable_backpressure=1
debug.sf.latch_unsignaled=1
ro.opengles.version=196610
ro.sf.hwrotation=0
ro.mtk_blulight_def_support=1
ro.mtk_aal_support=1
ro.mtk_pq_support=2
ro.mtk_pq_color_mode=1

# DRM
drm.service.enabled=true
ro.mtk_widevine_drm_l3_support=1
ro.mtk_cta_drm_support=1
ro.mtk_oma_drm_support=1

# Media
media.settings.xml=/vendor/etc/media_profiles_V1_0.xml
# MTK VDEC: hold playback until the first key frame (AOSP plays too early).
mtk.vdec.waitkeyframeforplay=1
ro.mtk_wmv_playback_support=1
ro.mtk_flv_playback_support=1
ro.have_aacencode_feature=1
ro.mtk_deinterlace_support=1

# FM radio
fmradio.driver.enable=1
ro.mtk_fm_50khz_support=1

# GPS / GNSS
ro.mtk_gps_support=1
ro.mtk_agps_app=1
ro.mtk_log_hide_gps=0

# Radio / telephony (dual SIM)
persist.radio.default.sim=0
persist.radio.fd.counter=150
persist.radio.fd.off.counter=50
persist.radio.fd.off.r8.counter=50
persist.radio.fd.r8.counter=150
persist.radio.lte.chip=0
persist.radio.mobile.data=0,0
persist.radio.mtk_dsbp_support=1
persist.radio.mtk_ps2_rat=L/W/G
persist.radio.mtk_ps3_rat=G
persist.radio.multisim.config=dsds
persist.radio.smart.data.switch=1
ril.external.md=0
ril.first.md=1
ril.flightmode.poweroffMD=0
ril.radiooff.poweroffMD=0
ril.read.imsi=1
ril.specific.sm_cause=0
ril.telephony.mode=0
ro.radio.simcount=2
ro.telephony.default_network=9,9
ro.telephony.sim.count=2
ro.mtk_ril_mode=c6m_1rild
ro.mtk_lte_support=1
ro.mtk_sim_hot_swap=1
ro.mtk_sim_hot_swap_common_slot=1
ro.mtk_data_config=1
ro.mtk_eap_sim_aka=1
ro.mtk_embms_support=1
ro.mtk_external_sim_only_slots=0
ro.mtk_external_sim_support=1
ro.mtk_md_world_mode_support=1
ro.mtk_modem_monitor_support=1
ro.mtk_rild_read_imsi=1
ro.mtk_world_phone_policy=0
ro.sim_me_lock_mode=0
ro.sim_refresh_reset_by_modem=1
ro.com.android.mobiledata=true
bgw.current3gband=0

# IMS
persist.mtk.volte.enable=1
persist.mtk_ims_support=1
persist.mtk_mims_support=2
persist.mtk_ussi_support=1
persist.mtk_vilte_support=1
persist.mtk_viwifi_support=1
persist.mtk_volte_support=1
persist.mtk_wfc_support=1
persist.mtk_epdg_support=1
persist.mtk_ct_volte_support=1
persist.mtk_dynamic_ims_switch=1
ro.md_auto_setup_ims=1

# Android 10 MTK IMS donor stack (Realme C2 QP1A). The A10 ImsService APK and
# mediatek-telephony code read the vendor-namespaced property names below,
# while the stock 8.1 modem/RIL blobs above read the unprefixed persist.mtk_*
# / ro.md_* names, so both sets are kept.
persist.vendor.ims_support=1
persist.vendor.mims_support=2
persist.vendor.mtk_wfc_support=1
persist.vendor.mtk_volte_enable=1
persist.vendor.mtk_vilte_enable=1
persist.vendor.volte_support=1
persist.vendor.vilte_support=1
persist.vendor.viwifi_support=1
persist.vendor.mtk_ct_volte_support=1
persist.vendor.mtk_dynamic_ims_switch=1
ro.vendor.md_auto_setup_ims=1
ro.vendor.md_mims_support=2
# Read by the Android 10 volte_imcb / volte_imsm_93 binaries; all MTK A10
# device trees set this to 1.
ro.vendor.md_prop_ver=1

# Modem / CCCI
ro.num_md_protocol=2
ro.mtk_protocol1_rat_config=Lf/Lt/W/T/G
mtk.eccci.c2k=enabled
ro.mtk_enable_md1=1
ro.mtk_single_bin_modem_support=1
ro.mtk_send_rr_support=1
ro.mtk_rebootmeta_support=0

# Wi-Fi / connectivity
ro.mtk_wlan_support=1
ro.wlan.gen=gen4m
mediatek.wlan.chip=CONSYS_MT6765
mediatek.wlan.module.postfix=_consys_mt6765
persist.mtk.wcn.combo.chipid=-1
persist.mtk.wcn.coredump.mode=0
persist.mtk.wcn.dynamic.dump=0
persist.mtk.wcn.patch.version=-1
persist.mtk.connsys.poweron.ctl=0
ro.mtk_wapi_support=1
ro.connsys.dedicated.log=1
ro.mtk_dhcpv6c_wifi=1
ro.ap_info_monitor=0
ro.mtk_wappush_support=1
service.wcn.driver.ready=no

# Bluetooth
ro.mtk_bt_support=1
bt.profiles.avrcp.multiPlayer.enable=0
# AOSP system/bt reads the prefix-less name to disable the offload path.
persist.bluetooth.a2dp_offload.disabled=true

# WFD
ro.mtk_wfd_support=1
wfd.dummy.enable=1
wfd.iframesize.level=0

# Platform identification (MTK blobs and rc files branch on these)
ro.mediatek.platform=MT6765
ro.mediatek.chip_ver=S01
ro.mediatek.version.branch=alps-mp-o1.mp6.tc16sp
ro.mediatek.version.sdk=4
ro.mtk_bsp_package=1
ro.mtk_emmc_support=1
ro.mtk_f2fs_enable=0
ro.mtk_config_max_dram_size=0x800000000
ro.mtk_is_tablet=0
ro.mtk_shared_sdcard=1
ro.mtk_omacp_support=1
ro.mtk_tee_gp_support=1
ro.mtk_trustonic_tee_support=1
ro.hardware.kmsetkey=trustonic

# Storage / init
ro.frp.pst=/dev/block/platform/bootdevice/by-name/frp
ro.mount.fs=EXT4
ro.sys.sdcardfs=1
ro.oem_unlock_supported=1

# USB
persist.sys.usb.config=mtp
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.storage.type=mtp
persist.service.acm.enable=0

# Dalvik / ART (stock heap sizing for 3/4 GB RAM)
dalvik.vm.heapgrowthlimit=384m
dalvik.vm.heapsize=512m

# Power / boot
sys.ipo.disable=1
sys.ipo.pwrdncap=2
ro.mtk_pow_perf_support=1

# Misc
persist.meta.dumpdata=0
ro.email_support_ucs2=0
ro.ksc5601_write=0
ro.mtk_afw_support=1
ro.mtk_bip_scws=1
ro.mtk_cta_set=1
ro.mtk_search_db_support=1
ro.opa.eligible_device=true
ro.ussd_ksc5601=0
