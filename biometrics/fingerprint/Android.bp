cc_library_shared {
    name: "fingerprint.mt6765",
    relative_install_path: "hw",
    proprietary: true,
    compile_multilib: "both",
    srcs: ["fingerprint.c"],
    shared_libs: [
        "libhardware",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
