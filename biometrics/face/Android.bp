//
// Source-built android.hardware.biometrics.face@1.0 service for the OPPO
// CPH1909 (A5s, MT6765).
//
// Unlike fingerprint, there is no legacy HAL module to wrap and no AOSP face
// service to load one: Android 10 ships only the face@1.0 interface definition
// (hardware/interfaces/biometrics/face/1.0/*.hal), not a default implementation.
// The stock vendor face stack registers a *custom* interface
// (vendor.oppo.hardware.biometrics.face@1.0::IBiometricsFace) that the AOSP
// framework does not bind to.
//
// This service therefore provides the AOSP interface the Lineage framework
// expects and delegates every call to OppoFaceHal, the single forwarding
// boundary to the OPPO backend. OppoFaceHal forwards to the reconstructed
// vendor.oppo.hardware.biometrics.face@1.0 interface (built from
// interfaces/vendor/hardware/biometrics/face/1.0/, see OppoFaceHal.h). The
// stock vendor backend service is disabled in this build, so the proxy
// registers but reports OPERATION_NOT_SUPPORTED until it is enabled.
//
cc_binary {
    name: "android.hardware.biometrics.face@1.0-service",
    proprietary: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.face@1.0-service.rc"],
    srcs: [
        "Face.cpp",
        "OppoFaceHal.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.biometrics.face@1.0",
        "vendor.oppo.hardware.biometrics.face@1.0",
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
