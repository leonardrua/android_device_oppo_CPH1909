<!--
     CPH1909: 32-bit /vendor/lib contains libstagefright_soft_aacdec.so, but
     libstagefright_soft_xaacdec.so is not installed by the current build.
     Advertising OMX.google.xaac.decoder for audio/mp4a-latm therefore picks a
     component that fails to instantiate, so Facebook/Instagram AAC tracks fail
     with MediaPlayer error (1, -2147483648) and the video appears black and
     silent. Advertise the SoftAAC2 node whose library is actually present.
-->
<Included>
    <Decoders>
        <MediaCodec name="OMX.google.aac.decoder" type="audio/mp4a-latm">
            <Limit name="channel-count" max="6" />
            <Limit name="sample-rate" ranges="7350,8000,11025,12000,16000,22050,24000,32000,44100,48000" />
            <Limit name="bitrate" range="8000-576000" />
        </MediaCodec>
        <MediaCodec name="OMX.google.vorbis.decoder" type="audio/vorbis">
            <Limit name="channel-count" max="8" />
            <Limit name="sample-rate" ranges="8000,11025,12000,16000,22050,24000,32000,44100,48000" />
            <Limit name="bitrate" range="8000-500000" />
        </MediaCodec>
    </Decoders>
</Included>
