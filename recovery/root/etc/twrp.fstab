# TWRP mount table for OPPO A5s (CPH1909), aligned with the stock recovery
# fstab from recovery.img (SHA-256 d9513186..., OS 8.1.0 patch 2020-10-05).
# ODM kept as mountable ext4 (stock ro) plus raw odmdtbo backup target.
# Stock partitions are exposed for backup; raw partitions use image backups.
# No wipe flag is assigned to the stock raw partitions.
# <mount_point> <fs_type> <device> <flags>

# system/vendor/odm appear twice on purpose. The ext4 entry tells TWRP the
# partition is mountable, so backup archives only file contents into a tar.
# The *_image entry (fs_type emmc) tells TWRP it is a raw disk image, so it
# dd-clones the whole partition including free space -- the escape hatch for a
# filesystem that will not mount, or for restoring a foreign ROM. Same
# convention as Google's and TeamWin's own trees (e.g. android-9.0
# recovery.fstab for xiaomi_beryllium, google_shamrock).
#
# Both variants are in the backup list, so "Select All partitions" archives
# each of the three twice: a file tarball plus the raw image, which also
# carries the partition's empty space. The raw images add 5.77 GiB (system
# 4.20, vendor 1.31, odm 0.25 GiB, sizes from the MT6765 scatter table).
# That redundancy is deliberate -- the raw image is the only thing that can be
# restored when the filesystem will not mount, or when a foreign ROM has to be
# put back. Drop "backup" from an entry that should not be in the backup
# list.
#
# The flags on the ext4 entries are not optional. TWRP's fstab parser only
# marks a few mount points as backup-able by itself -- /system, /data,
# /cache and the adopted storage. /vendor and /odm are not in that list, so
# without an explicit "backup" they never appear in the backup list at all.
# The same goes for /odm_image: TWRP only knows /system_image and
# /vendor_image by name (Translate_Partition_Display_Names), so the odm raw
# entry needs the flag as well.
#
# flashimg keeps an entry available for restore and flashing even when it is
# not in the backup list.
/system ext4 /dev/block/platform/bootdevice/by-name/system
/vendor ext4 /dev/block/platform/bootdevice/by-name/vendor flags=backup
/odm ext4 /dev/block/platform/bootdevice/by-name/odm flags=display="ODM";backup
/system_image emmc /dev/block/platform/bootdevice/by-name/system flags=flashimg=1
/vendor_image emmc /dev/block/platform/bootdevice/by-name/vendor flags=flashimg=1
/odm_image emmc /dev/block/platform/bootdevice/by-name/odm flags=backup;flashimg=1

/boot emmc /dev/block/platform/bootdevice/by-name/boot flags=backup;flashimg
/recovery emmc /dev/block/platform/bootdevice/by-name/recovery flags=backup;flashimg
/cache ext4 /dev/block/platform/bootdevice/by-name/cache
/data ext4 /dev/block/platform/bootdevice/by-name/userdata flags=forceencrypt=/dev/block/platform/bootdevice/by-name/metadata
/misc emmc /dev/block/platform/bootdevice/by-name/para flags=display="Misc";backup;flashimg

/persistent emmc /dev/block/platform/bootdevice/by-name/frp flags=display="FRP";backup;flashimg
/proinfo emmc /dev/block/platform/bootdevice/by-name/proinfo flags=backup;flashimg
/nvram emmc /dev/block/platform/bootdevice/by-name/nvram flags=display="NVRAM";backup;flashimg
/nvcfg ext4 /dev/block/platform/bootdevice/by-name/nvcfg flags=backup
/nvdata ext4 /dev/block/platform/bootdevice/by-name/nvdata flags=backup
/protect_f ext4 /dev/block/platform/bootdevice/by-name/protect1 flags=backup
/protect_s ext4 /dev/block/platform/bootdevice/by-name/protect2 flags=backup
/vendor/persist ext4 /dev/block/platform/bootdevice/by-name/persist flags=display="Persist";backup
/opporeserve ext4 /dev/block/platform/bootdevice/by-name/opporeserve2 flags=display="OPPO Reserve";backup
/bootloader emmc /dev/block/platform/bootdevice/by-name/lk flags=display="LK";backup;flashimg
/bootloader2 emmc /dev/block/platform/bootdevice/by-name/lk2 flags=display="LK2";backup;flashimg
/logo emmc /dev/block/platform/bootdevice/by-name/logo flags=backup;flashimg
/expdb emmc /dev/block/platform/bootdevice/by-name/expdb flags=backup;flashimg
/seccfg emmc /dev/block/platform/bootdevice/by-name/seccfg flags=backup;flashimg
/tee1 emmc /dev/block/platform/bootdevice/by-name/tee1 flags=display="TEE 1";backup;flashimg
/tee2 emmc /dev/block/platform/bootdevice/by-name/tee2 flags=display="TEE 2";backup;flashimg
/scp1 emmc /dev/block/platform/bootdevice/by-name/scp1 flags=display="SCP 1";backup;flashimg
/scp2 emmc /dev/block/platform/bootdevice/by-name/scp2 flags=display="SCP 2";backup;flashimg
/sspm_1 emmc /dev/block/platform/bootdevice/by-name/sspm_1 flags=display="SSPM 1";backup;flashimg
/sspm_2 emmc /dev/block/platform/bootdevice/by-name/sspm_2 flags=display="SSPM 2";backup;flashimg
/md1img emmc /dev/block/platform/bootdevice/by-name/md1img flags=display="MD1 Image";backup;flashimg
/md1dsp emmc /dev/block/platform/bootdevice/by-name/md1dsp flags=display="MD1 DSP";backup;flashimg
/md1arm7 emmc /dev/block/platform/bootdevice/by-name/md1arm7 flags=display="MD1 ARM7";backup;flashimg
/md3img emmc /dev/block/platform/bootdevice/by-name/md3img flags=display="MD3 Image";backup;flashimg
/spmfw emmc /dev/block/platform/bootdevice/by-name/spmfw flags=display="SPM Firmware";backup;flashimg
/boot_para emmc /dev/block/platform/bootdevice/by-name/boot_para flags=display="Boot Parameters";backup;flashimg
/reserve2 emmc /dev/block/platform/bootdevice/by-name/reserve2 flags=display="Reserve 2";backup;flashimg
/odmdtbo emmc /dev/block/platform/bootdevice/by-name/odmdtbo flags=display="ODM DTBO";backup;flashimg

/external_sd auto /dev/block/mmcblk1p1 /dev/block/mmcblk1 flags=storage;wipeingui;removable;display="External SDcard"
/usb_otg auto /dev/block/sda1 /dev/block/sda flags=display="USB-OTG";storage;wipeingui;removable
