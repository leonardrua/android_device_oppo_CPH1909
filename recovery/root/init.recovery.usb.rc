on early-init
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1

on init
    mkdir /config
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell

    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0xd001
    write /config/usb_gadget/g1/bcdDevice 0x0223
    write /config/usb_gadget/g1/bcdUSB 0x0200

    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}

    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    # Enable the Microsoft OS descriptor. Without this the four lines above
    # are dead: the kernel latches gi->use_os_desc into cdev->use_os_string
    # at bind time (configfs_composite_bind), and the "MSFT100" OS string
    # plus the vendor request that returns the MTP extended compatibility ID
    # list are only served when it is set. The symlink has to come first --
    # os_desc_link() only accepts a target that is already registered in
    # cdev->configs, which happens when configs/b.1 is mkdir'ed.
    write /config/usb_gadget/g1/os_desc/use 1

    mkdir /config/usb_gadget/g1/functions/mass_storage.0
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    # MTP uses a FunctionFS gadget function, ffs.mtp, and TWRP's
    # libtwrpmtp-ffs drives it. This needs PLATFORM_SDK_VERSION >= 28, which
    # is what this branch builds against (twrp-9.0); the twrp-8.1 branch
    # keeps the MTK mtp.gs0 function and libtwrpmtp-legacy instead, because
    # the legacy library talks /dev/mtp_usb and knows nothing about
    # FunctionFS-MTP.
    #
    # The configfs name is FUNC.INSTANCE and configfs's function_make()
    # splits it at the first dot, so "ffs.mtp" means the f_fs driver with
    # the instance name "mtp". f_fs's set_inst_name() accepts any name; the
    # MTP protocol over FunctionFS is implemented in userspace, by TWRP's
    # MtpFfsHandle, not by a separate kernel driver.
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    # The owner is root, not "mtp": the recovery ramdisk has no /etc/passwd,
    # so init cannot resolve the name and would fail the chown. The mount
    # options below set the ownership of the endpoint files themselves.
    mkdir /dev/usb-ffs/mtp 0770 root root
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1

    setprop sys.usb.controller musb-hdrc
    setprop sys.usb.configfs 1

on fs
    wait /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/mmcblk0boot0
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/mmcblk0boot1
    write /sys/class/power_supply/usb/otg_switch 1

on post-fs
    mkdir /system/bin

on boot
    setprop sys.usb.config mtp,adb


on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    stop adbd
    setprop sys.usb.ffs.ready 0
    setprop sys.usb.ffs.mtp.ready 0
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    setprop sys.usb.state ${sys.usb.config}

# The handlers below re-arm os_desc/use before every bind. The kernel latches
# gi->use_os_desc into cdev->use_os_string when the controller is bound
# (configfs_composite_bind), so the flag has to be in place before the write
# that binds it -- setting it once at init is enough for the first bind, but
# re-arming it keeps every later bind consistent with it.
on property:sys.usb.config=adb && property:sys.usb.configfs=1
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=sideload && property:sys.usb.configfs=1
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=sideload && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state ${sys.usb.config}

# The MTP function can only be bound once TWRP's MTP server has written the
# descriptors: a FunctionFS function has no endpoints until userspace has
# described them. The server sets sys.usb.ffs.mtp.ready after it has done
# so, which is what this waits for.
on property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.config=mtp && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    start adbd

# Both functions have to be described by userspace before the gadget can be
# bound: adbd sets sys.usb.ffs.ready, TWRP's MTP server sets
# sys.usb.ffs.mtp.ready.
#
# The MS OS descriptor's "MTP" compatible ID now comes from the descriptor
# set the MTP server writes (TWRP's mtp_os_desc_compat, CompatibleID
# "MTP", with FUNCTIONFS_HAS_MS_OS_DESC), not from a function-level
# configfs attribute -- only f_mtp.c creates one of those, and this branch
# no longer uses f_mtp.
on property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state ${sys.usb.config}

