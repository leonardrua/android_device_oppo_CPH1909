on init
    #create mountpoint for /vendor/persist partition
    mkdir /vendor/persist 0771 system system
    mount ext4 /dev/block/platform/bootdevice/by-name/persist /vendor/persist rw

on post-fs
    mkdir /vendor/persist 0771 system system
    mount ext4 /dev/block/platform/bootdevice/by-name/persist /vendor/persist rw
    chown system system /vendor/persist
    chmod 0771 /vendor/persist

    # We restorecon /vendor/persist to set SEPolicy label.
    restorecon /vendor/persist

    # MobiCore Daemon Paths.
    #
    # mcDriverDaemon reads the keymaster auth token container from
    # $MC_AUTH_TOKEN_PATH/00000000.authtokcont, so this has to be exported
    # BEFORE the daemon is started: init hands its environment to the
    # services it spawns, and a variable exported afterwards never reaches a
    # process that is already running.
    #
    # The stock value is /efs, which does not exist on this device. The
    # persist partition is the only persistent, writable location available
    # when the daemon starts -- trustonic.rc mounts it in "on init", and the
    # daemon already keeps its registry database (Store_XX.tf, So.Root,
    # So.Sp, So.TrustletCont) there via --P1.
    write /proc/bootprof "MOBICORE: export MC_AUTH_TOKEN_PATH /vendor/persist"
    export MC_AUTH_TOKEN_PATH /vendor/persist

    write /proc/bootprof "MOBICORE: Starting mcDriverDaemon"
    start mobicore

on post-fs-data
    # Create /data/key_provisioning dir and get proper encryption policy installed
    # Key Installation
    mkdir /data/key_provisioning 0771 system system
    mkdir /vendor/persist/mcRegistry 0771 system system

# For META/FACTORY mode
# Android 8.x reports the unencrypted state as "unsupported"; "unencrypted"
# is the pre-Oreo value and never fires here, so /data/misc/mcRegistry was
# never created for an unencrypted /data.
on property:ro.crypto.state=unsupported
    write /proc/bootprof "MOBICORE: create /data/misc/mcRegistry ++ (unencrypted)"
    mkdir /data/misc/mcRegistry 0775 system system
    # Expose the persisted auth token container in the registry directory.
    # The daemon's first registry search path is /data/misc/mcRegistry, while
    # the container itself lives on the persist partition.
    symlink /vendor/persist/00000000.authtokcont /data/misc/mcRegistry/00000000.authtokcont
    write /proc/bootprof "MOBICORE: create /data/misc/mcRegistry -- (unencrypted)"

# Normal mode, FBE
on property:ro.crypto.type=file && property:ro.crypto.state=encrypted
    write /proc/bootprof "MOBICORE: create /data/misc/mcRegistry ++ (FBE encrypted)"
    mkdir /data/misc/mcRegistry 0775 system system
    symlink /vendor/persist/00000000.authtokcont /data/misc/mcRegistry/00000000.authtokcont
    write /proc/bootprof "MOBICORE: create /data/misc/mcRegistry -- (FBE encrypted)"

# Normal mode, FDE
# TWRP does not run vold, so vold.decrypt=trigger_restart_framework is never
# set here -- that is an Android trigger. The FDE path in TWRP sets
# ro.crypto.state=encrypted and ro.crypto.type=block itself, in
# TWPartitionManager::Decrypt_Device(), so key off those instead.
on property:ro.crypto.state=encrypted && property:ro.crypto.type=block
    write /proc/bootprof "MOBICORE: create /data/misc/mcRegistry ++ (FDE encrypted)"
    mkdir /data/misc/mcRegistry 0775 system system
    symlink /vendor/persist/00000000.authtokcont /data/misc/mcRegistry/00000000.authtokcont
    write /proc/bootprof "MOBICORE: create /data/misc/mcRegistry -- (FDE encrypted)"

# Start Daemon with all Trustonic driver applets present in recovery ramdisk
service mobicore /vendor/bin/mcDriverDaemon --P1 /vendor/persist -r /vendor/app/mcRegistry/020f0000000000000000000000000000.drbin -r /vendor/app/mcRegistry/030b0000000000000000000000000000.drbin -r /vendor/app/mcRegistry/030d0000000000000000000000000000.drbin -r /vendor/app/mcRegistry/05070000000000000000000000000000.drbin -r /vendor/app/mcRegistry/05120000000000000000000000000000.drbin -r /vendor/app/mcRegistry/07150000000000000000000000000000.drbin -r /vendor/app/mcRegistry/07170000000000000000000000000000.drbin -r /vendor/app/mcRegistry/09070000000000000000000000000000.drbin
    user system
    group system
    class core
    priority -20
    oneshot

