import /trustonic.rc

on post-fs
    start hwservicemanager

# The HALs must not be started before hwservicemanager is up: a HIDL
# service that registers while hwservicemanager is still listening loses its
# registration and exits.
#
# hwservicemanager.ready is set by hwservicemanager itself once it is up
# (system/hwservicemanager/service.cpp), which is a sharper signal than
# init.svc.hwservicemanager=running -- that only says the process is alive.
# TWRP's own vold_decrypt path waits for the same property
# (crypto/vold_decrypt/vold_decrypt.cpp). The realme C2 tree groups its HAL
# starts this way too.
#
# The attestation and cryptoeng services are the TEE-facing half of the
# keymaster chain on this device: vendor/manifest.xml declares both HALs, so
# without them hwservicemanager logs a load failure for each on every boot.
on property:hwservicemanager.ready=true
    start kmsetkey_ca
    start keymaster-3-0
    start gatekeeper-1-0
    start keymaster_attestation-1-1
    start oppo-cryptoeng-1-0

on fs
    # USB
    write /sys/class/power_supply/usb/otg_switch 1

    # Install the keyring the crypto stack looks in. It was previously
    # gated on ro.crypto.type=file, which is the file-encrypted path; the
    # realme C2 tree installs it here unconditionally, so both crypto types
    # get it.
    install_keyring

# Tear the TEE stack down once /data is decrypted.
#
# The Trustonic daemon keeps the TEE resident and the keymaster/gatekeeper
# HALs hold the keystore; none of it is needed once /data is readable. The
# sibling MT6765 tree (TWRP Gerrit android_device_nokia_WSP_sprout) stops the
# same set.
#
# twrp.decrypt.done is the signal that actually fires. TWRP sets it in
# TWPartitionManager::Post_Decrypt(), which runs on a successful decrypt for
# both the FBE and the FDE path, and only on success -- a failed decrypt
# returns before reaching it. twrp.all.users.decrypted is only set for FBE
# (Check_Users_Decryption_Status() is inside #ifdef TW_INCLUDE_FBE), so on
# an FDE device, which is what this one is, it never fires.
#
# Stopping the keymaster HAL is safe on this device: the FDE path uses the
# software keystore (/sbin/keystore), not the TEE keymaster. On an FBE device
# the HAL would still be needed, so only stop the TEE-only services there.
#
# init can bring any of these back with "setprop ctl.start <service>", so a
# later Format Data that re-encrypts /data can restart the stack.
on property:twrp.decrypt.done=true
    stop kmsetkey_ca
    stop keymaster_attestation-1-1
    stop oppo-cryptoeng-1-0
    stop keymaster-3-0
    stop gatekeeper-1-0
    stop mobicore
    stop hwservicemanager

on property:twrp.all.users.decrypted=true
    stop kmsetkey_ca
    stop keymaster_attestation-1-1
    stop oppo-cryptoeng-1-0
    stop keymaster-3-0
    stop gatekeeper-1-0
    stop mobicore
    stop hwservicemanager

service hwservicemanager /sbin/hwservicemanager
    user root
    group root
    onrestart setprop hwservicemanager.ready false
    disabled
    seclabel u:r:recovery:s0

service keystore_auth /sbin/keystore_auth
    oneshot
    user system
    group root
    disabled
    seclabel u:r:recovery:s0

# keystore is started and stopped on demand by TWRP
service keystore /sbin/keystore /tmp/misc/keystore
    user root
    group root drmrpc readproc log
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/sbin:/system/lib64:/system/lib
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keymaster-3-0 /vendor/bin/hw/android.hardware.keymaster@3.0-service
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/sbin:/system/lib64:/system/lib
    disabled
    oneshot
    seclabel u:r:recovery:s0

# MTK keymaster attestation. Reaches the TEE through libMcClient (already
# needed by kmsetkey.trustonic.so), and is what libkmsetkey.so talks to when
# it verifies the attest keybox. Registered via vendor/manifest.xml, which
# resolves to the -impl.so in vendor/lib64/hw.
service keymaster_attestation-1-1 /vendor/bin/hw/vendor.mediatek.hardware.keymaster_attestation@1.1-service
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/sbin:/system/lib64:/system/lib
    disabled
    oneshot
    seclabel u:r:recovery:s0

# OPPO crypto engine, declared as vendor.oppo.hardware.cryptoeng 1.0 in the
# same manifest.
service oppo-cryptoeng-1-0 /vendor/bin/hw/vendor.oppo.hardware.cryptoeng@1.0-service
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/sbin:/system/lib64:/system/lib
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Trustonic keybox check/verify. The sibling MT6765 tree runs its equivalent
# (bp_kmsetkey_ca) as a late_start oneshot. This tree has shipped the binary
# since e367bd6 without ever starting it. Failure here is harmless: it is a
# verification step, not part of the decrypt path.
service kmsetkey_ca /vendor/bin/kmsetkey_ca.trustonic -c
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
