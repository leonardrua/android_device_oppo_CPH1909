# Adapted from Lotus lineage-17.1 commit 6af58d2a ("Label light HIDL and
# grant required permissions"). Lotus declared sysfs_light/sysfs_graphics;
# Android 10's canonical type for LED-class sysfs nodes is sysfs_leds, and the
# CPH1909 lights HAL writes only /sys/class/leds/lcd-backlight/brightness.
#
# Keep the explicit grants here because this is a source-built, OPPO-specific
# HAL rather than the stock AOSP light implementation.
allow hal_light_default sysfs_leds:dir r_dir_perms;
allow hal_light_default sysfs_leds:file rw_file_perms;
allow hal_light_default sysfs_leds:lnk_file read;
