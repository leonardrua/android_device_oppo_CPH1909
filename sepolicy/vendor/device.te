# Type declarations and permissive domains for OPPO CPH1909 bring-up.
#
# The stock ColorOS policy declares roughly 200 MediaTek/OPPO types that have
# no Android 10 equivalent. Porting all of it before the device has ever
# booted would be guesswork, so this file declares the types the labelling in
# file_contexts refers to and marks the vendor domains permissive.
#
# Bring-up order that this supports:
#   1. Build and boot with these domains permissive.
#   2. Collect real denials from the device (`dmesg | grep avc`).
#   3. Convert the denials into allow rules, then drop the permissive lines
#      one domain at a time.
#
# Shipping a release with these permissive lines still present would be a
# security regression -- they exist only so that a missing rule logs instead
# of preventing boot.

###
### MediaTek HAL domains
###
type mtk_hal_dfps, domain;
type mtk_hal_dfps_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_dfps)
hal_server_domain(mtk_hal_dfps, hal_graphics_composer)

type mtk_hal_keyattestation, domain;
type mtk_hal_keyattestation_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_keyattestation)

type mtk_hal_mms, domain;
type mtk_hal_mms_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_mms)

type mtk_hal_mtkcodecservice, domain;
type mtk_hal_mtkcodecservice_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_mtkcodecservice)

type mtk_hal_pq, domain;
type mtk_hal_pq_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_pq)

type mtk_hal_soter, domain;
type mtk_hal_soter_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_soter)

###
### Trustonic Kinibi TEE
###
type mcd, domain;
type mcd_exec, exec_type, vendor_file_type, file_type;
# mcd_data_file labels /vendor/app/mcRegistry, which holds 30 read-only Kinibi
# trustlet/driver blobs shipped on the vendor partition. It therefore needs
# vendor_file_type ("All types in /vendor", public/attributes:44); sepolicy_tests
# rejects the build with "The following types on /vendor/ must be associated with
# the vendor_file_type attribute: mcd_data_file" without it.
#
# data_file_type was wrong here and has been dropped. attributes:34 defines it as
# "All types used for /data files", and AOSP never puts both attributes on one
# type. The name is a misnomer inherited from the stock policy -- nothing under
# /vendor/app is writable.
#
# The registry directories the daemon actually writes are separate paths that
# vendor/etc/init/trustonic.rc creates at runtime: /data/misc/mcRegistry and
# /vendor/persist/mcRegistry (the latter falls under mtk_persist_file). Neither
# is labelled here; if mcDriverDaemon is denied access to /data/misc/mcRegistry
# after first boot, that needs its own core_data_file_type type.
type mcd_data_file, file_type, vendor_file_type;
init_daemon_domain(mcd)

type mobicore_device, dev_type;

