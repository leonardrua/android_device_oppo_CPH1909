###
### Misc MediaTek device nodes
###
type mtk_smi_device, dev_type;
type mtk_sched_device, dev_type;
type mtk_accdet_device, dev_type;
# mtk_uio_device removed: /dev/uio[0-9]* is already labelled uio_device by
# plat_file_contexts (AOSP public/device.te:49), and declaring a second type for
# the same path made checkfc reject file_contexts.bin with "Multiple different
# specifications". These are ordinary uio character devices.
type mtk_adsp_device, dev_type;
type mtk_pq_device, dev_type;

# Android 10 dropped both of these from system/sepolicy/public/device.te, so a
# device that still has the nodes has to declare them itself:
#
#   gps_device    -- /dev/gps and /dev/stpgps. Present in AOSP up to 8.1; the
#                    GNSS HAL is expected to own the node now, but the MTK stack
#                    (mnld, mtk_agpsd) opens the character device directly.
#   sw_sync_device -- /dev/sw_sync. Removed once explicit sync fences replaced
#                    the legacy sw_sync ioctl interface, which the MT6765
#                    display driver still exposes.
#
# Both are labelled in file_contexts; without the declaration checkfc rejects
# the whole vendor_file_contexts.
type gps_device, dev_type;
type sw_sync_device, dev_type;

###
### rutilsdaemon -- the seclabel MediaTek's rc files name for shell helpers
###
# init.mt6765.rc:123-127 defines
#     service swap_enable_init /system/bin/sh /system/etc/swap_enable.sh
#     seclabel u:r:rutilsdaemon:s0
# and `on fs` starts it unconditionally (init.mt6765.rc:141-142). With the domain
# undeclared, setexeccon fails and the forked child dies before exec
# (system/core/init/service.cpp:325-327) -- init itself survives, but zram is
# never configured and the device runs with no swap.
#
# No init_daemon_domain() here and no *_exec type: the service execs
# /system/bin/sh, which plat_file_contexts already labels shell_exec, and a
# second domain_auto_transition on shell_exec would collide with the shell
# domain AOSP already defines for it. The transition comes from the seclabel in
# the rc file instead, which is exactly what seclabel is for.
#
# Permissive like the rest of the bring-up domains -- the script writes to
# /sys/block/zram0/* and /proc/sys/vm/swappiness and calls mkswap/swapon, and the
# real rule set for that should come from observed denials, not from guessing.
type rutilsdaemon, domain;
permissive rutilsdaemon;

###
### Permissive during bring-up -- REMOVE before any release build
###
permissive mtk_hal_dfps;
permissive mtk_hal_keyattestation;
permissive mtk_hal_mms;
permissive mtk_hal_mtkcodecservice;
permissive mtk_hal_pq;
permissive mtk_hal_soter;
permissive mcd;
permissive mtk_muxd;
permissive mtk_muxreport;
permissive mtk_ccci;
permissive mtk_md_ctrl;
permissive mtk_volte;
permissive mtk_nvram_daemon;
permissive mtk_sysenv;
permissive mtk_mnld;
permissive mtk_agpsd;
permissive mtk_lbs;
permissive mtk_wmt_loader;
permissive mtk_wod;
permissive mtk_ipsec_mon;
permissive mtk_netdagent;
permissive mtk_thermal;
permissive mtk_fuelgauged;

###
### OPPO / Silead biometrics and factory services
###
# None of these interfaces exist upstream, so each service gets its own domain,
# marked permissive for the same reason as the rest of this file: get the device
# booting first, then convert the denials it logs into rules and drop the
# permissive lines one domain at a time.
#
# The face and fingerprint services keep using hal_face_default_exec /
# hal_fingerprint_default_exec from AOSP (they implement those standard
# interfaces), so no new type is declared for them here.
type mtk_hal_silead, domain;
type mtk_hal_silead_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_silead)
permissive mtk_hal_silead;

# cryptoeng backs the OPPO key/attestation extras, ktv is the OPPO TV-out
# companion service. Both are dormant on a normal boot but their rc files are
# imported, so their domains have to exist.
type mtk_hal_cryptoeng, domain;
type mtk_hal_cryptoeng_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_cryptoeng)
permissive mtk_hal_cryptoeng;

type mtk_hal_ktv, domain;
type mtk_hal_ktv_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_ktv)
permissive mtk_hal_ktv;

# Factory / engineering-mode services.
type mtk_hal_factory, domain;
type mtk_hal_factory_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_factory)
permissive mtk_hal_factory;

type mtk_factory_bin, domain;
type mtk_factory_bin_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_factory_bin)
permissive mtk_factory_bin;
