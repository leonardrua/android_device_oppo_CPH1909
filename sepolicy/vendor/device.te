# CPH1909/OPPO-only type declarations and grants. Generic MediaTek domains,
# hwservice types and HAL rules are provided by device/mediatek/sepolicy/non_plat.

### Device-private HAL domains ###


### Trustonic Kinibi TEE ###
type mtk_hal_soter, domain;
type mtk_hal_soter_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_soter)

type hal_soter_hwservice, hwservice_manager_type;
add_hwservice(mtk_hal_soter, hal_soter_hwservice)
allow mtk_hal_soter mobicore_device:chr_file { ioctl read write open };
allow system_app hal_soter_hwservice:hwservice_manager find;
allow system_app mtk_hal_soter:binder { call transfer };
allow mtk_hal_soter system_app:binder { call transfer };
allow system_app mtk_hal_soter:fd use;
allow mtk_hal_soter system_app:fd use;

### Device-private hwservice types (see hwservice_contexts) ###
type mtk_hal_wifi_hostapd_hwservice, hwservice_manager_type;
type mtk_hal_wfo_hwservice, hwservice_manager_type;
type volte_uce_ua_hwservice, hwservice_manager_type;
type hal_mtkcodecservice_hwservice, hwservice_manager_type;
type mtk_hal_netdagent_hwservice, hwservice_manager_type;
type volte_rcs_ua_hwservice, hwservice_manager_type;
type factory_interface_hwservice, hwservice_manager_type;
type mtk_hal_mwis_hwservice, hwservice_manager_type;
type hal_cryptoeng_hwservice, hwservice_manager_type;
type hal_fingerprintpay_hwservice, hwservice_manager_type;

hwbinder_use(mtk_hal_soter)
hwbinder_use(MtkCodecService)
hwbinder_use(mtk_hal_cryptoeng)
hwbinder_use(mtk_hal_factory)
hwbinder_use(mtk_netdagent)

# Grants the common policy does not supply: common's add_hwservice for
# bluetooth is commented out; power runs as hal_power_default here, not
# mtk_hal_power; fingerprintpay is OPPO-only.
add_hwservice(hal_bluetooth_default, mtk_hal_bluetooth_hwservice)
add_hwservice(hal_power_default, mtk_hal_power_hwservice)
add_hwservice(hal_fingerprint_default, hal_fingerprintpay_hwservice)

### Vendor property type and writers (must match property_contexts) ###
type mtk_persist_prop, property_type;
get_prop(domain, mtk_persist_prop)

set_prop(rild, mtk_persist_prop)
set_prop(mtk_ccci, mtk_persist_prop)
set_prop(epdg_wod, mtk_persist_prop)
set_prop(stp_dump3, mtk_persist_prop)
set_prop(mtk_wmt_loader, mtk_persist_prop)
set_prop(volte_imcb, mtk_persist_prop)
set_prop(volte_imsm_93, mtk_persist_prop)
set_prop(mtk_volte_stack, mtk_persist_prop)
set_prop(volte_ua, mtk_persist_prop)
set_prop(vtservice_hidl, mtk_persist_prop)
set_prop(mnld, mtk_persist_prop)
set_prop(aee_aedv, mtk_persist_prop)
set_prop(mcd, mtk_persist_prop)
set_prop(mtk_hal_pq, mtk_persist_prop)
set_prop(hal_graphics_composer_default, mtk_persist_prop)
set_prop(hal_audio_default, mtk_persist_prop)
set_prop(hal_bluetooth_default, mtk_persist_prop)
set_prop(hal_camera_default, mtk_persist_prop)
set_prop(mtk_factory_bin, mtk_persist_prop)
set_prop(system_app, mtk_persist_prop)
set_prop(hal_fingerprint_default, mtk_persist_prop)
set_prop(mtk_hal_silead, mtk_persist_prop)
set_prop(mtk_netdagent, mtk_persist_prop)
set_prop(hal_keymaster_default, mtk_persist_prop)
set_prop(mtk_hal_soter, mtk_persist_prop)
set_prop(system_server, mtk_persist_prop)
set_prop(platform_app, mtk_persist_prop)
set_prop(shell, mtk_persist_prop)

add_hwservice(MtkCodecService, hal_mtkcodecservice_hwservice)
allow system_server mtk_hal_rild_hwservice:hwservice_manager find;

### Trustonic Kinibi TEE (continued) ###
type mcd, domain;
type mcd_exec, exec_type, vendor_file_type, file_type;
type mcd_data_file, file_type, vendor_file_type;
init_daemon_domain(mcd)

type mobicore_device, dev_type;

# /dev/mobicore-user is needed by the MTK keymaster TA client; first-OTA AVC:
# hal_keymaster_default -> mobicore_device:chr_file read write, permissive=0.
allow hal_keymaster_default mobicore_device:chr_file { open read write ioctl };

# TBaseDeviceBinding is a shell-invoked provisioning helper that transitions
# into the Kinibi daemon domain (mcd).
type tbase_device_binding_exec, exec_type, vendor_file_type, file_type;
allow shell tbase_device_binding_exec:file { read getattr execute execute_no_trans open };
allow shell mcd:process transition;
allow mcd tbase_device_binding_exec:file entrypoint;
type_transition shell tbase_device_binding_exec:process mcd;
allow shell mobicore_device:chr_file { open read write ioctl };

### Telephony / modem device-private domains ###
type mtk_ccci, domain;
type mtk_ccci_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_ccci)

type mtk_md_ctrl, domain;
type mtk_md_ctrl_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_md_ctrl)

add_hwservice(volte_imcb, volte_uce_ua_hwservice)

type mtk_volte_stack, domain;
type mtk_volte_stack_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_volte_stack)

add_hwservice(volte_ua, volte_rcs_ua_hwservice)


### NVRAM / persistent factory data ###
type mtk_sysenv, domain;
type mtk_sysenv_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_sysenv)

# Legacy /vendor mount points (common uses /mnt/vendor/* with different types).
type oppo_reserve_file, file_type;
type oppo_reserve_block_device, dev_type;

allow init {
    nvdata_file
    nvcfg_file
    persist_data_file
    protect_f_data_file
    protect_s_data_file
    oppo_reserve_file
}:dir mounton;

### GNSS datagram channel (mnld is not a hal_gnss server/client) ###
allow mnld hal_gnss_default:unix_dgram_socket sendto;

### WiFi / connectivity device-private domains ###
type mtk_wmt_loader, domain;
type mtk_wmt_loader_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_wmt_loader)

type mtk_netdagent, domain;
type mtk_netdagent_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_netdagent)
add_hwservice(mtk_netdagent, mtk_hal_netdagent_hwservice)

# /dev/wmtdetect keeps the device-specific mtk_stpwmt_device label (WMT scope
# left untouched); stpwmt/wmtWifi themselves use common device-node types.
type mtk_stpwmt_device, dev_type;

### AEE core_pattern usermodehelper ###
typeattribute kernel system_executes_vendor_violators;
allow kernel aee_core_forwarder_exec:file { read getattr map execute open };
allow kernel aee_core_forwarder:process transition;
type_transition kernel aee_core_forwarder_exec:process aee_core_forwarder;
allow aee_core_forwarder aee_core_forwarder_exec:file { read getattr map execute entrypoint open };
allow aee_core_forwarder vendor_data_file:dir { create add_name write search };
allow aee_core_forwarder aee_core_vendor_file:dir create_dir_perms;
allow aee_core_forwarder aee_core_vendor_file:file create_file_perms;
allow aee_core_forwarder kernel:fd use;
allow aee_core_forwarder kernel:fifo_file read;
allow aee_core_forwarder aee_aedv:unix_stream_socket connectto;



### Offline charging (KPOC) -- kpoc_charger.rc seclabel u:r:kpoc_charger:s0 ###
type kpoc_charger, domain, coredomain;
type kpoc_charger_exec, exec_type, system_file_type, file_type;
init_daemon_domain(kpoc_charger)

allow kpoc_charger sysfs:dir r_dir_perms;
allow kpoc_charger sysfs:file rw_file_perms;
allow kpoc_charger sysfs:lnk_file read;
allow kpoc_charger sysfs_batteryinfo:dir r_dir_perms;
allow kpoc_charger sysfs_batteryinfo:file r_file_perms;
allow kpoc_charger sysfs_batteryinfo:lnk_file read;
allow kpoc_charger sysfs_leds:dir r_dir_perms;
allow kpoc_charger sysfs_leds:file rw_file_perms;
allow kpoc_charger sysfs_wake_lock:file rw_file_perms;

allow kpoc_charger block_device:dir search;
allow kpoc_charger logo_block_device:blk_file { read open };
allow kpoc_charger graphics_device:dir search;
allow kpoc_charger graphics_device:chr_file { ioctl read write getattr open };
allow kpoc_charger input_device:dir r_dir_perms;
allow kpoc_charger input_device:chr_file { ioctl read write open };

allow kpoc_charger kmsg_device:chr_file { write open };
allow kpoc_charger rtc_device:chr_file { read write open };
allow kpoc_charger alarm_device:chr_file write;
allow kpoc_charger mtd_device:dir search;
allow kpoc_charger mtd_device:chr_file read;
allow kpoc_charger property_socket:sock_file write;
allow kpoc_charger init:unix_stream_socket connectto;

allow kpoc_charger self:capability { sys_nice sys_boot };
allow kpoc_charger self:capability2 block_suspend;
allow kpoc_charger self:netlink_kobject_uevent_socket { create bind read setopt };

### Misc device nodes ###
type mtk_pq_device, dev_type;
type gps_device, dev_type;

### rutilsdaemon -- seclabel in init.mt6765.rc (swap_enable.sh) ###
type rutilsdaemon, domain;
permissive rutilsdaemon;

### Bring-up permissive domains retained for device-private domains only ###
permissive hal_face_default;
permissive hal_fingerprint_default;
permissive MtkCodecService;
permissive mtk_hal_soter;
permissive mcd;
permissive mtk_ccci;
permissive mtk_md_ctrl;
permissive mtk_volte_stack;
permissive mtk_sysenv;
permissive mtk_wmt_loader;
permissive mtk_netdagent;
permissive aee_core_forwarder;

### OPPO / Silead biometrics and factory services ###
type oppoalgo_daemon, domain;
type oppoalgo_daemon_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(oppoalgo_daemon)

type oppoalgo_service, vndservice_manager_type;
add_service(oppoalgo_daemon, oppoalgo_service)
vndbinder_use(oppoalgo_daemon)
allow hal_camera_default oppoalgo_service:service_manager find;
allow cameraserver oppoalgo_daemon:binder call;
allow hal_camera_default oppoalgo_daemon:binder { call transfer };
allow oppoalgo_daemon hal_camera_default:binder { call transfer };
allow oppoalgo_daemon hal_graphics_allocator_default:binder call;
allow oppoalgo_daemon hal_configstore_default:binder call;

type silead_fpd_device, dev_type;
type egis_device, dev_type;

# Stock 8.1 data types; face_* need core_data_file_type for the /data rule.
type silead_fpd_data_file, file_type, data_file_type;
type face_data_file, file_type, data_file_type, core_data_file_type;
type face_picture_file, file_type, data_file_type, core_data_file_type;

typeattribute hal_face_default data_between_core_and_vendor_violators;
allow hal_fingerprint_default silead_fpd_device:chr_file rw_file_perms;
allow hal_fingerprint_default egis_device:chr_file rw_file_perms;
allow hal_fingerprint_default silead_fpd_data_file:file create_file_perms;
allow hal_fingerprint_default silead_fpd_data_file:dir { ioctl read write getattr lock add_name remove_name search open };
allow hal_face face_data_file:file create_file_perms;
allow hal_face face_data_file:dir { ioctl read write getattr lock add_name remove_name search open };

type mtk_hal_silead, domain;
type mtk_hal_silead_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_silead)
permissive mtk_hal_silead;

type mtk_hal_cryptoeng, domain;
type mtk_hal_cryptoeng_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_cryptoeng)
add_hwservice(mtk_hal_cryptoeng, hal_cryptoeng_hwservice)
permissive mtk_hal_cryptoeng;

permissive oppoalgo_daemon;

type mtk_hal_factory, domain;
type mtk_hal_factory_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_factory)
add_hwservice(mtk_hal_factory, factory_interface_hwservice)
permissive mtk_hal_factory;

type mtk_factory_bin, domain;
type mtk_factory_bin_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_factory_bin)
permissive mtk_factory_bin;
