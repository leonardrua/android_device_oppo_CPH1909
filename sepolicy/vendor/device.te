# Type declarations and permissive domains for OPPO CPH1909 bring-up.
#
# The stock ColorOS policy declares roughly 200 MediaTek/OPPO types that have
# no Android 10 equivalent. Porting all of it before the device has ever
# booted would be guesswork, so this file declares the types the labelling in
# file_contexts refers to and marks the vendor domains permissive.
#
# Bring-up order that this supports:
#   1. Build and boot with these domains permissive.
#   2. Collect real denials from the device (`dmesg | grep avc`).
#   3. Convert the denials into allow rules, then drop the permissive lines
#      one domain at a time.
#
# Shipping a release with these permissive lines still present would be a
# security regression -- they exist only so that a missing rule logs instead
# of preventing boot.

###
### MediaTek HAL domains
###
# DFPS is a MediaTek-private HAL (`vendor.mediatek.hardware.dfps`), not part of
# Android's graphics-composer HAL. The stock 8.1 policy has a dedicated
# hal_dfps attribute with surfaceflinger, system_server and mtk_hal_power as
# clients. Reusing hal_graphics_composer here would put mtk_hal_dfps in
# hal_graphics_composer_server and, through
# hal_attribute_hwservice(graphics_composer, hal_graphics_composer_hwservice),
# grant it `add` on the *standard* composer hwservice type.
hal_attribute(dfps)

type mtk_hal_dfps, domain;
type mtk_hal_dfps_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_dfps)
hal_server_domain(mtk_hal_dfps, hal_dfps)

type mtk_hal_keyattestation, domain;
type mtk_hal_keyattestation_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_keyattestation)

type mtk_hal_mms, domain;
type mtk_hal_mms_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_mms)

type mtk_hal_mtkcodecservice, domain;
type mtk_hal_mtkcodecservice_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_mtkcodecservice)

type mtk_hal_pq, domain;
type mtk_hal_pq_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_pq)

type mtk_hal_soter, domain;
type mtk_hal_soter_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_hal_soter)

# The Trustonic Soter HAL registers vendor.qti.hardware.soter@1.0::ISoter
# with hwservicemanager and talks to the Kinibi TEE through
# /dev/mobicore-user. SoterService (com.tencent.soter.soterserver) runs in the
# system_app domain and is the only client. These rules mirror the stock
# O-MR1 vendor policy (hal_soter_trustonic / hal_soter_hwservice), including
# both binder directions for the HIDL callback objects.
type hal_soter_hwservice, hwservice_manager_type;
add_hwservice(mtk_hal_soter, hal_soter_hwservice)
allow mtk_hal_soter mobicore_device:chr_file { ioctl read write open };
allow system_app hal_soter_hwservice:hwservice_manager find;
allow system_app mtk_hal_soter:binder { call transfer };
allow mtk_hal_soter system_app:binder { call transfer };
allow system_app mtk_hal_soter:fd use;
allow mtk_hal_soter system_app:fd use;

# HwBinder service types for the MTK/OPPO vendor HALs declared in
# sepolicy/vendor/hwservice_contexts. Each type is declared here and the
# corresponding HAL domain is granted add/find on its own hwservice type
# (plus hidl_base_hwservice for the root descriptor). Clients in the
# system_app / hal_* domains get find rules where the stock policy has them.
#
# The stock 8.1 vendor policy (nonplat_sepolicy.cil) grants these same
# transitions; without them, every vendor HIDL service registers as
# default_hwservice and the per-interface type transitions are impossible.

# --- MediaTek hwservice types ---
type mtk_hal_bluetooth_hwservice, hwservice_manager_type;
type mtk_hal_rild_hwservice, hwservice_manager_type;
type mtk_hal_power_hwservice, hwservice_manager_type;
type mtk_hal_lbs_hwservice, hwservice_manager_type;
type mtk_hal_wifi_hostapd_hwservice, hwservice_manager_type;
type mtk_hal_imsa_hwservice, hwservice_manager_type;
type nvram_agent_binder_hwservice, hwservice_manager_type;
type mtk_hal_pq_hwservice, hwservice_manager_type;
type mtk_hal_keyattestation_hwservice, hwservice_manager_type;
type mtk_hal_mms_hwservice, hwservice_manager_type;
type mtk_hal_wfo_hwservice, hwservice_manager_type;
type mtk_hal_keyinstall_hwservice, hwservice_manager_type;
type mtk_hal_videotelephony_hwservice, hwservice_manager_type;
type volte_uce_ua_hwservice, hwservice_manager_type;
type hal_mtkcodecservice_hwservice, hwservice_manager_type;
type mtk_hal_netdagent_hwservice, hwservice_manager_type;
type volte_rcs_ua_hwservice, hwservice_manager_type;
type mtk_hal_dfps_hwservice, hwservice_manager_type;
# Stock 8.1 labels interfaces.factory{Ata,Interface} with this type. Both are
# declared in this tree's manifest and implemented by the factory service.
type factory_interface_hwservice, hwservice_manager_type;
# IMwis is declared in the device manifest as on stock. No server binary ships
# in this tree, so there is deliberately no add_hwservice grant yet.
type mtk_hal_mwis_hwservice, hwservice_manager_type;

# --- OPPO hwservice types ---
type hal_cryptoeng_hwservice, hwservice_manager_type;
type hal_fingerprintpay_hwservice, hwservice_manager_type;

# add_hwservice() only grants hwservice_manager { add find } on the interface
# plus add on hidl_base_hwservice. The server still needs binder access to
# hwservicemanager to actually make that call; Q provides it via hwbinder_use().
# Stock 8.1 granted the same binder access to every daemon listed here.
hwbinder_use(mtk_hal_soter)
hwbinder_use(mtk_hal_dfps)
hwbinder_use(mtk_hal_keyattestation)
hwbinder_use(mtk_hal_mms)
hwbinder_use(mtk_hal_mtkcodecservice)
hwbinder_use(mtk_hal_pq)
hwbinder_use(mtk_hal_cryptoeng)
hwbinder_use(mtk_hal_factory)
hwbinder_use(mtk_volte_imcb)
hwbinder_use(mtk_volte_ua)
hwbinder_use(mtk_vtservice)
hwbinder_use(mtk_nvram_daemon)
hwbinder_use(mtk_lbs)
hwbinder_use(mtk_netdagent)
hwbinder_use(mtk_mnld)

# Stock 8.1 grants add/find on these hwservice types to the standard HAL
# domains that register them. Without these, hwservicemanager denies the
# registration on an enforcing build even though the interfaces are labelled
# in hwservice_contexts. (D-03)
add_hwservice(hal_bluetooth_default, mtk_hal_bluetooth_hwservice)
add_hwservice(rild, mtk_hal_rild_hwservice)
add_hwservice(hal_power_default, mtk_hal_power_hwservice)
add_hwservice(hal_wifi_hostapd_default, mtk_hal_wifi_hostapd_hwservice)
add_hwservice(hal_fingerprint_default, hal_fingerprintpay_hwservice)

# Property type for the MediaTek / OPPO persist keys labelled in
# sepolicy/vendor/property_contexts. AOSP only allows init and vendor_init to
# set default_prop (public/domain.te), so without a dedicated type no vendor
# daemon can persist its own settings on an enforcing build.
#
# Reads are granted to every domain below so no consumer loses access to a key
# it already reads; writes go to the daemons that own them.
type mtk_persist_prop, property_type;
get_prop(domain, mtk_persist_prop)

# Writers, by the rc service / blob that sets each family:
#   rild, mtk_ccci, mtk_wod, mtk_stp_dump, mtk_wmt_loader  - radio / modem /
#       connectivity feature switches and persist.mtk_*
#   mtk_volte_imcb, mtk_volte_imsm_93, mtk_volte_stack,
#   mtk_volte_ua, mtk_vtservice                           - IMS / VT keys
#   mtk_mnld                                              - persist.radio.mnl.prop
#   mtk_aee, mcd                                          - aee / dumpstate keys
#   mtk_hal_pq, hal_graphics_composer_default              - display/PQ keys
#   hal_audio_default                                     - persist.af.*
#   hal_bluetooth_default                                 - persist.bt.*
#   hal_camera_default                                    - persist.camera.*
#   mtk_factory_bin                                       - factory keys
#   system_app                                            - the IMS APK
#       (com.mediatek.ims) writes persist.mtk_* through SystemProperties.set
set_prop(rild, mtk_persist_prop)
set_prop(mtk_ccci, mtk_persist_prop)
set_prop(mtk_wod, mtk_persist_prop)
set_prop(mtk_stp_dump, mtk_persist_prop)
set_prop(mtk_wmt_loader, mtk_persist_prop)
set_prop(mtk_volte_imcb, mtk_persist_prop)
set_prop(mtk_volte_imsm_93, mtk_persist_prop)
set_prop(mtk_volte_stack, mtk_persist_prop)
set_prop(mtk_volte_ua, mtk_persist_prop)
set_prop(mtk_vtservice, mtk_persist_prop)
set_prop(mtk_mnld, mtk_persist_prop)
set_prop(mtk_aee, mtk_persist_prop)
set_prop(mcd, mtk_persist_prop)
set_prop(mtk_hal_pq, mtk_persist_prop)
set_prop(hal_graphics_composer_default, mtk_persist_prop)
set_prop(hal_audio_default, mtk_persist_prop)
set_prop(hal_bluetooth_default, mtk_persist_prop)
set_prop(hal_camera_default, mtk_persist_prop)
set_prop(mtk_factory_bin, mtk_persist_prop)
set_prop(system_app, mtk_persist_prop)

# --- HAL domains: add/find on their own hwservice type ---
#
# Rules for a HAL service type must go through the attribute macros, not raw
# allow rules. hal_attribute_hwservice() in system/sepolicy/public/te_macros
# generates, for hal_gnss:
#
#     allow hal_gnss_client hal_gnss_hwservice:hwservice_manager find;
#     add_hwservice(hal_gnss_server, hal_gnss_hwservice)
#       -> allow hal_gnss_server hal_gnss_hwservice:hwservice_manager { add find };
#       -> neverallow { domain -hal_gnss_server } hal_gnss_hwservice:hwservice_manager add;
#
# and build_test_only adds
#
#     neverallow { domain -hal_gnss_client -hal_gnss_server } \
#         hal_gnss_hwservice:hwservice_manager find;
#
# Raw `allow ... hal_gnss_hwservice ...` rules for mtk_mnld would violate both
# neverallows because mnld is neither a hal_gnss client nor server in this port;
# see the GNSS section for its actual datagram-channel access.

# MediaTek daemons with device-private hwservice types. Those types are
# declared in this file, not in AOSP, so there is no platform neverallow naming
# the type itself and a plain allow would satisfy checkpolicy -- but that is
# exactly why add_hwservice() is used instead. Its second line,
# `allow $1 hidl_base_hwservice:hwservice_manager add`, is not optional: a
# domain registering a service through hwservicemanager needs add on the base
# descriptor, and public/domain.te:521 neverallows `find` on
# hidl_base_hwservice, leaving `add` as the only permitted verb. AOSP grants it
# in every add_hwservice() call, so all twelve of these servers had their
# service type covered while missing the base-descriptor grant. The macro also
# adds the neverallow { domain -$1 } that keeps other domains from registering
# the same type.
# DFPS is a device-private HAL interface, so use its own attribute rather than
# an upstream HAL's attribute. This grants the server add/find on its own
# hwservice type and gives the stock clients find: surfaceflinger and
# system_server (fingerprint policy service users) and the MTK power HAL.
hal_attribute_hwservice(hal_dfps, mtk_hal_dfps_hwservice)
hal_client_domain(surfaceflinger, hal_dfps)
hal_client_domain(system_server, hal_dfps)
hal_client_domain(hal_power_default, hal_dfps)
add_hwservice(mtk_hal_keyattestation, mtk_hal_keyattestation_hwservice)
add_hwservice(mtk_hal_mms, mtk_hal_mms_hwservice)
add_hwservice(mtk_hal_mtkcodecservice, hal_mtkcodecservice_hwservice)
add_hwservice(mtk_hal_pq, mtk_hal_pq_hwservice)

# --- Client find rules ---
#
# system_server already gets hal_gnss_hwservice find from AOSP's
# `hal_client_domain(system_server, hal_gnss)` in private/system_server.te,
# and hal_camera_hwservice find from its own hal_camera_client membership.
# Repeating either here is redundant and, for hal_camera, a neverallow
# violation (hal_camera_client is not an attribute system_server carries), so
# both raw rules are deliberately absent.
allow system_server mtk_hal_power_hwservice:hwservice_manager find;
allow system_server mtk_hal_rild_hwservice:hwservice_manager find;
# rild finds the modem HAL.
allow rild mtk_hal_rild_hwservice:hwservice_manager find;

###
### Trustonic Kinibi TEE
###
type mcd, domain;
type mcd_exec, exec_type, vendor_file_type, file_type;
# mcd_data_file labels /vendor/app/mcRegistry, which holds 30 read-only Kinibi
# trustlet/driver blobs shipped on the vendor partition. It therefore needs
# vendor_file_type ("All types in /vendor", public/attributes:44); sepolicy_tests
# rejects the build with "The following types on /vendor/ must be associated with
# the vendor_file_type attribute: mcd_data_file" without it.
#
# data_file_type was wrong here and has been dropped. attributes:34 defines it as
# "All types used for /data files", and AOSP never puts both attributes on one
# type. The name is a misnomer inherited from the stock policy -- nothing under
# /vendor/app is writable.
#
# The registry directories the daemon actually writes are separate paths that
# vendor/etc/init/trustonic.rc creates at runtime: /data/misc/mcRegistry and
# /vendor/persist/mcRegistry (the latter falls under mtk_persist_file). Neither
# is labelled here; if mcDriverDaemon is denied access to /data/misc/mcRegistry
# after first boot, that needs its own core_data_file_type type.
type mcd_data_file, file_type, vendor_file_type;
init_daemon_domain(mcd)

type mobicore_device, dev_type;

###
### Telephony / modem
###
type mtk_muxd, domain;
type mtk_muxd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_muxd)

type mtk_muxreport, domain;
type mtk_muxreport_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_muxreport)

type mtk_ccci, domain;
type mtk_ccci_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_ccci)

type mtk_md_ctrl, domain;
type mtk_md_ctrl_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_md_ctrl)

# Keep the four stock MTK IMS daemons in separate domains, as in the stock
# vendor policy. They remain permissive during bring-up so denials can be
# collected per process before writing allow rules.
type mtk_volte_imcb, domain;
type mtk_volte_imcb_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_volte_imcb)
add_hwservice(mtk_volte_imcb, volte_uce_ua_hwservice)

type mtk_volte_imsm_93, domain;
type mtk_volte_imsm_93_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_volte_imsm_93)

type mtk_volte_stack, domain;
type mtk_volte_stack_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_volte_stack)

type mtk_volte_ua, domain;
type mtk_volte_ua_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_volte_ua)
add_hwservice(mtk_volte_ua, volte_rcs_ua_hwservice)

# vtservice_hidl (vendor/bin/hw/vtservice_hidl, init.vtservice.rc): MTK's
# VoLTE video-telephony service, class hal. /system/bin/vtservice is the
# companion service (class main) and cannot share this domain: domains
# entered from /system must carry coredomain (treble_sepolicy_tests) and
# types labeling /system paths must carry system_file_type
# (sepolicy_tests), while domains/types entered from /vendor must not.
type mtk_vtservice, domain;
type mtk_vtservice_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_vtservice)
add_hwservice(mtk_vtservice, mtk_hal_videotelephony_hwservice)
type mtk_vtservice_main, domain, coredomain;
type mtk_vtservice_main_exec, exec_type, system_file_type, file_type;
init_daemon_domain(mtk_vtservice_main)

type mtk_ttyc_device, dev_type;
type mtk_ccci_device, dev_type;

###
### NVRAM / persistent factory data
###
type mtk_nvram_daemon, domain;
type mtk_nvram_daemon_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_nvram_daemon)
add_hwservice(mtk_nvram_daemon, nvram_agent_binder_hwservice)

type mtk_sysenv, domain;
type mtk_sysenv_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_sysenv)

# Stock partition file types. All except oppo_reserve_file live under /vendor,
# so they carry vendor_file_type (sepolicy_tests requires every /vendor file
# type to be associated with that attribute). No rules beyond the mounton
# allows below: AOSP neverallows forbid every domain -- including init -- from
# create/write/setattr/append/unlink/rename and relabelto on vendor_file_type,
# so the stock init.mt6765.rc chmod/chown/mkdir on them can only fail in an
# enforcing build (the dirs exist in the vendor image as mount points created
# by Android.mk). oppo_reserve_file is mounted at /opporeserve (root, not
# under /vendor) and stays a plain file_type.
type mtk_nvdata_file, file_type, vendor_file_type;
type mtk_nvcfg_file, file_type, vendor_file_type;
type mtk_protect_f_file, file_type, vendor_file_type;
type mtk_protect_s_file, file_type, vendor_file_type;
type mtk_persist_file, file_type, vendor_file_type;
type oppo_reserve_file, file_type;

type nvdata_block_device, dev_type;
type nvcfg_block_device, dev_type;
type nvram_block_device, dev_type;
type proinfo_block_device, dev_type;
type protect1_block_device, dev_type;
type protect2_block_device, dev_type;
type persist_block_device, dev_type;
type seccfg_block_device, dev_type;
type expdb_block_device, dev_type;
type logo_block_device, dev_type;
type oppo_reserve_block_device, dev_type;

###
### init access to the OPPO / MediaTek partition mount points
###
# fs_mgr, running in init for this legacy-Treble (API 27) device, mounts the
# vendor subpartitions on directories labelled with the types declared above
# (the stock factory labels are not in this policy, so the mounted roots are
# unlabeled). AOSP's mounton allow list covers only the platform types, so
# these need explicit allows. init is exempt from the
# { domain -init } mounton neverallow; the vendor_file_type mkdir/setattr/
# relabelto neverallows cannot be satisfied from here at all.
allow init {
    mtk_nvdata_file
    mtk_nvcfg_file
    mtk_persist_file
    mtk_protect_f_file
    mtk_protect_s_file
    oppo_reserve_file
}:dir mounton;

###
### GNSS
###
type mtk_mnld, domain;
type mtk_mnld_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_mnld)

# mtk_mnld is MTK's standalone GNSS daemon (/vendor/bin/mnld). It is NOT the
# HIDL server: manifest.xml declares vendor.mediatek.hardware.gnss@1.1::IMtkGnss
# and file_contexts labels that service hal_gnss_default_exec, so AOSP's
# hal_gnss_default is the server. The stock O-MR1 policy likewise lists
# hal_gnss_default/mtk_hal_gnss in hal_gnss_server/system_server in
# hal_gnss_client, with mnld outside both; mnld talks to the GNSS HAL over
# datagram sockets. Do not make mnld a hal_gnss server/client here: that would
# grant it add/find on the standard hal_gnss_hwservice type it never registers.
allow mtk_mnld hal_gnss_default:unix_dgram_socket sendto;

type mtk_agpsd, domain;
type mtk_agpsd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_agpsd)

type mtk_lbs, domain;
type mtk_lbs_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_lbs)
add_hwservice(mtk_lbs, mtk_hal_lbs_hwservice)

