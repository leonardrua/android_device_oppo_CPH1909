###
### OPPO / Silead biometrics and factory HALs
###
# These four families have no AOSP equivalent, so each gets its own exec type and
# a permissive domain declared in device.te. They are deliberately mapped onto
# the standard hal_face / hal_fingerprint attributes where the interface matches,
# so that the framework's biometric stack can talk to them once bring-up is done.
/(vendor|system/vendor)/bin/hw/vendor\.oppo\.hardware\.biometrics\.face@1\.0-service            u:object_r:hal_face_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.oppo\.hardware\.biometrics\.fingerprint@2\.1-service     u:object_r:hal_fingerprint_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.oppo\.hardware\.biometrics\.fingerprintpay@1\.0-service  u:object_r:hal_fingerprint_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.silead\.hardware\.fingerprintext@1\.0-service            u:object_r:mtk_hal_silead_exec:s0

# Silead fingerprint sensor nodes (CONFIG_SILEAD_FP + /dev/silead_fp in the
# authoritative 8.1 kernel). The AOSP fingerprint@2.1 service wraps the stock
# legacy Silead HAL module via the fingerprint.mt6765 shim.
/dev/silead_fp                                                                                  u:object_r:silead_fpd_device:s0
/dev/esfp0                                                                                      u:object_r:egis_device:s0
# Silead calibration/template data and the ColorOS face-unlock data dirs.
# The /data regex mirrors the stock 8.1 vendor file_contexts exactly
# (/data/(vendor|system)/silead); the persist entry additionally covers the
# /mnt/vendor/persist mounted view. No AOSP attribute rule touches these
# types -- the device.te allows above are the only grants, so they must stay
# in sync with the stock ones.
/data/(vendor|system)/silead(/.*)?                                                              u:object_r:silead_fpd_data_file:s0
/(mnt/vendor/)?persist/silead(/.*)?                                                             u:object_r:silead_fpd_data_file:s0
/data/system/users/[0-9]+/facedata(/.*)?                                                        u:object_r:face_data_file:s0
/data/system/users/[0-9]+/faceunlock(/.*)?                                                      u:object_r:face_picture_file:s0

/(vendor|system/vendor)/bin/hw/vendor\.oppo\.hardware\.cryptoeng@1\.0-service                      u:object_r:mtk_hal_cryptoeng_exec:s0

# Factory / engineering services. These only run in Meta and factory modes, but
# they exist in the vendor image and still need a label.
