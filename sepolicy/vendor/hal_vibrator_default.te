# The AOSP libhardware vibrator module checks
# /sys/class/timed_output/vibrator/enable first and then falls back to
# /sys/class/leds/vibrator/{activate,state,duration}. Our MTK kernel only
# creates the LEDs-class device, so the fallback path is the one that matters.
#
# public/hal_vibrator.te already grants hal_vibrator the sysfs_vibrator dir
# search and file rw permissions, and the genfs_contexts entry in this
# directory relabels /sys/class/leds/vibrator (and its attribute files) to
# sysfs_vibrator. What was missing is the traversal of the *parent*
# /sys/class/leds directory, which stays sysfs_leds; on the first OTA this
# produced:
#
#   avc: denied { search } for comm="android.hardwar" name="leds"
#        scontext=u:r:hal_vibrator_default:s0
#        tcontext=u:object_r:sysfs_leds:s0 tclass=dir permissive=0
#
# making every access to the fallback node look like ENOENT to the HAL:
#   vibrator_open failed: -19
#   Passthrough failed to open legacy HAL.
#   Could not get passthrough implementation for
#   android.hardware.vibrator@1.0::IVibrator/default
# The sysfs_leds dir search is now granted by the common MediaTek
# non_plat/hal_vibrator.te via the hal_vibrator attribute.

# The LEDs-class entry can be a symlink to the device's sysfs directory;
# reading through it needs permission on the link itself as well.
allow hal_vibrator_default sysfs_vibrator:lnk_file r_file_perms;
